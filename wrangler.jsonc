{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The shop: UI, auth, Stripe and tracker webhooks, sponsor and owner dashboards.
  // Top level: `pnpm dev` on this machine. `env.dev` and `env.production` are
  // deployed by .github/workflows/deploy.yml; CLOUDFLARE_ENV picks one at build.
  "name": "yarrow-web-local",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Runs next to Supabase (eu-west-1, dev and prod): a query costs 1-3 ms, not 25.
  "placement": { "region": "aws:eu-west-1" },
  "upload_source_maps": true,
  // The landing's film goes through the Worker, which answers ranges.
  "assets": { "binding": "ASSETS", "run_worker_first": ["/demo/*"] },
  // Public values only, repeated in each environment (vars are not inherited).
  // Secrets (DATABASE_URL, STRIPE_*, GITHUB_APP_*, tracker OAuth secrets,
  // TOKEN_ENCRYPTION_KEY) are set with `wrangler secret put NAME --env <env>`
  // and, locally, in .dev.vars.
  "vars": {
    "APP_URL": "http://localhost:3000",
    // The yarrow-dev Supabase project, shared by local and dev.yarrow.run.
    "SUPABASE_URL": "https://pporkihcsomdpycmmsvn.supabase.co",
    // Publishable by design (browser-safe). RLS denies it every table.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable__m1NrrN9toP3yF---p7KGQ_PhxCVlGL",
    "GITHUB_APP_SLUG": "yarrow-run-dev",
  },
  // Screenshots and videos of runs, written by the brain (simulated here).
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "yarrow-evidence-local" },
  ],
  // The landing's sample agent: a visitor's turns a minute, then everyone's.
  "ratelimits": [
    { "name": "TRY_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "TRY_CEILING", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
  ],
  "env": {
    // dev.yarrow.run, deployed on every push to main.
    "dev": {
      "name": "yarrow-web-dev",
      "routes": [{ "pattern": "dev.yarrow.run", "custom_domain": true }],
      "workers_dev": false,
      // The brain's private `kick`: a queued ticket starts in seconds.
      "services": [
        {
          "binding": "BRAIN",
          "service": "yarrow-brain-dev",
          "entrypoint": "Brain",
        },
      ],
      "vars": {
        "APP_URL": "https://dev.yarrow.run",
        "SUPABASE_URL": "https://pporkihcsomdpycmmsvn.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable__m1NrrN9toP3yF---p7KGQ_PhxCVlGL",
        "GITHUB_APP_SLUG": "yarrow-run-dev",
      },
      "r2_buckets": [
        { "binding": "EVIDENCE", "bucket_name": "yarrow-evidence-dev" },
      ],
      "ratelimits": [
        { "name": "TRY_LIMIT", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
        { "name": "TRY_CEILING", "namespace_id": "1102", "simple": { "limit": 120, "period": 60 } },
      ],
    },
    // yarrow.run, deployed on every push to the prod branch, on the
    // yarrow-prod Supabase project.
    "production": {
      "name": "yarrow-web",
      "routes": [{ "pattern": "yarrow.run", "custom_domain": true }],
      "workers_dev": false,
      "services": [
        {
          "binding": "BRAIN",
          "service": "yarrow-brain",
          "entrypoint": "Brain",
        },
      ],
      "vars": {
        "APP_URL": "https://yarrow.run",
        "SUPABASE_URL": "https://uuqadmeppxjomigsrqbi.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_mWv10GKOPrn_pW6sWQdGMw_Z92XUBJy",
        "GITHUB_APP_SLUG": "yarrow-run",
      },
      "r2_buckets": [
        { "binding": "EVIDENCE", "bucket_name": "yarrow-evidence" },
      ],
      "ratelimits": [
        { "name": "TRY_LIMIT", "namespace_id": "1201", "simple": { "limit": 10, "period": 60 } },
        { "name": "TRY_CEILING", "namespace_id": "1202", "simple": { "limit": 120, "period": 60 } },
      ],
    },
  },
}
