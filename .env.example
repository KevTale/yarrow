# Copy to .env. Read by the Node scripts only: `pnpm db:migrate` and
# `pnpm bootstrap:anthropic`. The Workers read .dev.vars (see the examples).
# Test or staging values only, never production.

# Supabase > Connect > Transaction pooler (port 6543).
DATABASE_URL=

# Platform Console API key (console.anthropic.com), never a subscription.
ANTHROPIC_API_KEY=
