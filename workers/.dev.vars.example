# Copy to workers/.dev.vars: secrets of the brain Worker for `pnpm brain:dev`.
# Deployed: `wrangler secret put NAME --config workers/wrangler.jsonc --env dev|production`.
# Test or staging values only, never production.

DATABASE_URL=

# Platform API keys, never subscriptions.
ANTHROPIC_API_KEY=
# Printed by `pnpm bootstrap:anthropic`.
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=
OPENAI_API_KEY=

# Same GitHub App as the web Worker.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Tracker sync and ticket comments. Same values as the web Worker.
TOKEN_ENCRYPTION_KEY=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
TRELLO_API_KEY=
TRELLO_API_SECRET=

# Optional: the out-of-credit alert to ALERT_EMAIL. Same key as the web Worker.
RESEND_API_KEY=
