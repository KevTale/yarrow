{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The brain: dispatches queued tickets, runs each run as a durable
  // Workflow (Claude or Meta implements, OpenAI reviews), syncs trackers.
  // Top level: `pnpm brain:dev` on this machine. `env.dev` and
  // `env.production` are deployed by .github/workflows/deploy.yml.
  "name": "yarrow-brain-local",
  "main": "./brain.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workflows": [
    {
      "name": "yarrow-run-local",
      "binding": "WORKFLOW",
      "class_name": "AgentWorkWorkflow",
    },
    {
      "name": "yarrow-chat-local",
      "binding": "CHAT",
      "class_name": "ChatWorkflow",
    },
  ],
  // Every minute: dispatch. Every 5 minutes: Linear, Jira and Trello sync.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_URL": "http://localhost:3000",
    "GITHUB_APP_SLUG": "yarrow-run-dev",
    "OPENAI_REVIEW_MODEL": "gpt-6-astra",
    "OPENAI_REVIEW_EFFORT": "high",
    "DISPATCH": "on",
  },
  // Screenshots and videos of runs (simulated on this machine).
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "yarrow-evidence-local" },
  ],
  "observability": { "enabled": true },
  // Runs next to Supabase (eu-west-1, dev and prod): a query costs 1-3 ms, not 25.
  "placement": { "region": "aws:eu-west-1" },
  // Bindings and vars are not inherited: each environment repeats them.
  "env": {
    // Paired with dev.yarrow.run, deployed on every push to main.
    "dev": {
      "name": "yarrow-brain-dev",
      "workers_dev": false,
      "workflows": [
        {
          "name": "yarrow-run-dev",
          "binding": "WORKFLOW",
          "class_name": "AgentWorkWorkflow",
        },
        {
          "name": "yarrow-chat-dev",
          "binding": "CHAT",
          "class_name": "ChatWorkflow",
        },
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "APP_URL": "https://dev.yarrow.run",
        "GITHUB_APP_SLUG": "yarrow-run-dev",
        "OPENAI_REVIEW_MODEL": "gpt-6-astra",
        "OPENAI_REVIEW_EFFORT": "high",
        "DISPATCH": "on",
        "ADMIN_URL": "https://admin-dev.yarrow.run",
        // Out-of-credit alerts, sent through Resend when RESEND_API_KEY is set.
        "ALERT_EMAIL": "kevin.taleb.dehkordi@gmail.com",
        // Who implements new runs is the IMPLEMENTER secret, not a variable
        // here, so a deploy keeps it: "meta" (Muse Code + Muse Wonder in the
        // MUSE containers below, META_API_KEY secret) or "claude", the
        // default. Switched with pnpm implementer <claude|meta>.
        "META_MODEL": "muse-wonder-1.0",
        "META_EFFORT": "high",
        // The live call: who answers (src/runner/talk-models.ts), and the
        // bench's turns may choose (pnpm bench:talk).
        "TALK_MODEL": "sonnet",
        "TALK_BENCH": "on",
      },
      "r2_buckets": [
        { "binding": "EVIDENCE", "bucket_name": "yarrow-evidence-dev" },
      ],
      // One container per Meta run (workers/muse.ts), built from muse/Dockerfile,
      // and one per pull request's stage (workers/stage.ts), the same image.
      "durable_objects": {
        "bindings": [
          { "name": "MUSE", "class_name": "MuseSandbox" },
          { "name": "STAGE", "class_name": "Stage" },
        ],
      },
      "containers": [
        {
          "class_name": "MuseSandbox",
          "scheduling_policy": "durable_object",
          "images": { "muse": { "dockerfile": "./muse/Dockerfile" } },
        },
        {
          "class_name": "Stage",
          "scheduling_policy": "durable_object",
          "images": { "stage": { "dockerfile": "./muse/Dockerfile" } },
        },
      ],
      "exports": {
        "MuseSandbox": { "type": "durable-object", "storage": "sqlite" },
        "Stage": { "type": "durable-object", "storage": "sqlite" },
      },
    },
    // Paired with yarrow.run, deployed on every push to the prod branch.
    "production": {
      "name": "yarrow-brain",
      "workers_dev": false,
      "workflows": [
        {
          "name": "yarrow-run",
          "binding": "WORKFLOW",
          "class_name": "AgentWorkWorkflow",
        },
        {
          "name": "yarrow-chat",
          "binding": "CHAT",
          "class_name": "ChatWorkflow",
        },
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "APP_URL": "https://yarrow.run",
        "GITHUB_APP_SLUG": "yarrow-run",
        "OPENAI_REVIEW_MODEL": "gpt-6-astra",
        "OPENAI_REVIEW_EFFORT": "high",
        "DISPATCH": "on",
        "ADMIN_URL": "https://admin.yarrow.run",
        // Out-of-credit alerts, sent through Resend when RESEND_API_KEY is set.
        "ALERT_EMAIL": "kevin.taleb.dehkordi@gmail.com",
      },
      "r2_buckets": [
        { "binding": "EVIDENCE", "bucket_name": "yarrow-evidence" },
      ],
      // One container per pull request's stage (workers/stage.ts), for the
      // live call; Meta implements on dev only.
      "durable_objects": {
        "bindings": [{ "name": "STAGE", "class_name": "Stage" }],
      },
      "containers": [
        {
          "class_name": "Stage",
          "scheduling_policy": "durable_object",
          "images": { "stage": { "dockerfile": "./muse/Dockerfile" } },
        },
      ],
      "exports": {
        "Stage": { "type": "durable-object", "storage": "sqlite" },
      },
    },
  },
}
