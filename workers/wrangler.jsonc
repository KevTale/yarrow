{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The brain: dispatches queued tickets, runs each run as a durable
  // Workflow (Claude implements, OpenAI reviews), syncs trackers.
  "name": "yarrow-brain",
  "main": "./brain.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workflows": [
    {
      "name": "yarrow-run",
      "binding": "WORKFLOW",
      "class_name": "AgentWorkWorkflow",
    },
  ],
  // Every minute: dispatch. Every 5 minutes: Linear, Jira and Trello sync.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_URL": "http://localhost:3000",
    "OPENAI_REVIEW_MODEL": "gpt-6-astra",
    "DISPATCH": "on",
  },
  // Enable R2 in the Cloudflare dashboard, create the bucket, then uncomment:
  // "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "yarrow-evidence" }],
  "observability": { "enabled": true },
}
