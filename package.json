{
  "name": "agent-commons",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc -p workers/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "brain:dev": "wrangler dev --config workers/wrangler.jsonc",
    "brain:check": "wrangler deploy --dry-run --config workers/wrangler.jsonc --outdir .worker-build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.8",
    "drizzle-orm": "0.45.3",
    "geist": "^1.4.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.147.0"
  }
}
